# ==============================================================================
# AI JOB COMMAND CENTER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development. NEVER commit real credentials.
# ==============================================================================

# Application Environment
APP_ENV=local
APP_PORT=8080
APP_NAME=ai-job-command-center
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_command_center
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# Google / Gmail API OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth2/callback/google
GMAIL_SYNC_INTERVAL_MINUTES=15

# AI Provider Configuration
# Supported: OPENAI, ANTHROPIC, OLLAMA, GEMINI
AI_PROVIDER=OPENAI
AI_API_KEY=your_ai_provider_api_key_here
AI_MODEL_NAME=gpt-4o-mini
AI_LOCAL_BASE_URL=http://localhost:11434/api
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=30

# File Storage Configuration
STORAGE_TYPE=LOCAL
STORAGE_PATH=./storage/files
MAX_FILE_SIZE_MB=10

# Security & JWT Configuration
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_256_bits_long
JWT_EXPIRATION_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:4200
